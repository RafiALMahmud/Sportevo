# Only public client-side variables (VITE_ prefixed) belong here.
# They are bundled into the JS build and visible to every browser.
# Never put API secrets, private third-party keys or database credentials
# in this file — those belong in backend/.env.

VITE_APP_NAME="Sports Evo"

# Set to true to run the SPA against the built-in demo/mock API adapter.
VITE_DEMO_MODE=false
